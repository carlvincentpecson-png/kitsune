local pn = script.Parent.Parent.Parent.Script.Parent.Name
if pn == "BloxFruits" then
    local ui = GUI.newPanel()
    ui.Parent = FindMetaTable("Player").SelectedCharacter

    local function onButton1Down(btn)
        if btn.Name == "ColorSelect" then
            local menu = GUI.newPanel{
                Width = 200,
                Height = 150,
                CanvasWidth = 200,
                CanvasHeight = 150,
                BackgroundColor = Color3.new(0.7, 0.7, 0.7),
                --BackgroundTransparency = 0.4,
                Name = "ColorMenu",
                Position = UDim2.new(0, 0, 0, player.ScreenGrab:GetWidth() * 0.2),
                ZIndex = 1000
            }

            local red = Color3.new(1, 0, 0)
            local gold = Color3.new(1, 1, 0)
            local white = Color3.new(0.9, 0.9, 1)
            local silver = Color3.new(0.7, 0.7, 0.7)
            local galaxy = Color3.new(0.2, 0.2, 0.2, 0.5)

            for i, col in pairs({red, gold, white, silver, galaxy}) do
                local btn = GUI.newButton{
                    Text = "",
                    Width = 50,
                    Height = 50,
                    BackgroundColor3 = col,
                    BorderColor3 = col,
                    OnMouseDown = function(self)
                        ChangeSkin(col)
                        Notification("Skin Changed Successfully!")
                    end
                }

                btn[#btn+1] = {Text = name, BackgroundColor3 = col, BorderColor3 = col}
            end

            menu:AddItem(btn)
        end
    end

    function onEventGUI()
        local plyr = player
        local pn = plyr:GetCharacter():FindFirstChildWhichIsA("Humanoid")

        if pn ~= nil then
            local col = pn:GetCustomProperty("Color"):WaitForFirstChild()

            if col ~= nil then
                local btn = menu.ColorMenu:FindChildByName("ColorSelect")[1]
                local colStr = Color3.toHex(btn.BackgroundColor3)

                if string.match(colStr, "red") then
                    col = Color3.new(1, 0, 0)
                elseif string.match(colStr, "gold") then
                    col = Color3.new(1, 1, 0)
                elseif string.match(colStr, "white") then
                    col = Color3.new(0.9, 0.9, 1)
                elseif string.match(colStr, "silver") then
                    col = Color3.new(0.7, 0.7, 0.7)
                elseif string.match(colStr, "galaxy") then
                    col = Color3.new(0.2, 0.2, 0.2, 0.5)
                end

                local chs = plyr:GetCharacter():FindAllDescendantsOfClass("Model").HumanoidRootPart:FindAllDescendantsOfClass("Model")

                for _, ch in pairs(chs) do
                    ch:SetPrimaryHairColor(col)
                    ch:SetSecondaryHairColor(col)
                    ch:SetColor(col)
                end
            end
        end
    end

    function ChangeSkin(skin)
        coroutine.wrap(function()
            humanoid:WaitForChild("Head"):WaitForChild("Humanoid"):SetCustomProperty("Skin", skin)
            Notification("Skin Changed Successfully!")
        end)(coroutine.yield)("None")
    end
end
