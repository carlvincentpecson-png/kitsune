-- Western Dragon Fruit Spawner & Auto-Eater Script
-- Advanced Blox Fruits Script (Roblox Studio)

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")

-- Configuration
local WESTERN_DRAGON_ID = "WesternDragonFruit"  -- Custom identifier
local DRAGON_SKILLS = {
    "DragonBreath",
    "DragonClaw",
    "DragonFlight",
    "DragonTransform"
}

-- Spawn Western Dragon Fruit Function
function spawnWesternDragonFruit()
    -- Create visual fruit model
    local fruitModel = Instance.new("Part")
    fruitModel.Name = WESTERN_DRAGON_ID
    fruitModel.Size = Vector3.new(3, 3, 3)
    fruitModel.Position = HumanoidRootPart.Position + Vector3.new(0, 5, 5)
    fruitModel.Anchored = true
    fruitModel.CanCollide = true
    fruitModel.BrickColor = BrickColor.new("Bright blue")
    fruitModel.Material = Enum.Material.Neon
    
    -- Add glowing effect
    local glow = Instance.new("PointLight")
    glow.Parent = fruitModel
    glow.Color = Color3.fromRGB(0, 150, 255)
    glow.Range = 15
    glow.Brightness = 2
    
    -- Add fruit texture/mesh
    local mesh = Instance.new("SpecialMesh")
    mesh.Parent = fruitModel
    mesh.MeshType = Enum.MeshType.FileMesh
    mesh.MeshId = "rbxassetid://your_dragon_mesh_id"  -- Replace with actual mesh ID
    mesh.TextureId = "rbxassetid://your_dragon_texture_id"
    mesh.Scale = Vector3.new(2, 2, 2)
    
    -- Add interaction prompt
    local proximityPrompt = Instance.new("ProximityPrompt")
    proximityPrompt.Parent = fruitModel
    proximityPrompt.ActionText = "Eat Western Dragon Fruit"
    proximityPrompt.ObjectText = "Legendary Fruit"
    proximityPrompt.MaxActivationDistance = 10
    proximityPrompt.HoldDuration = 0.5
    
    -- Animation when spawned
    local tweenInfo = TweenInfo.new(2, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
    local tween = TweenService:Create(fruitModel, tweenInfo, {Position = HumanoidRootPart.Position + Vector3.new(0, 10, 0)})
    tween:Play()
    
    fruitModel.Parent = Workspace
    
    -- Trigger eat function when prompted
    proximityPrompt.Triggered:Connect(function()
        eatWesternDragonFruit(fruitModel)
    end)
    
    return fruitModel
end

-- Eat Western Dragon Fruit Function
function eatWesternDragonFruit(fruitModel)
    -- Remove fruit visually
    fruitModel:Destroy()
    
    -- Simulate eating animation
    local eatAnim = Instance.new("Animation")
    eatAnim.AnimationId = "rbxassetid://your_eating_animation_id"
    local animTrack = Character.Humanoid:LoadAnimation(eatAnim)
    animTrack:Play()
    
    -- Equip Dragon Fruit skills
    equipDragonSkills()
    
    -- Notify player
    game.StarterGui:SetCore("SendNotification", {
        Title = "Western Dragon Fruit",
        Text = "You have consumed the Western Dragon Fruit! Dragon skills equipped.",
        Icon = "rbxassetid://your_icon_id",
        Duration = 5
    })
end

-- Equip Dragon Skills Function
function equipDragonSkills()
    -- Find skill remote events/functions
    local remoteEvents = ReplicatedStorage:FindFirstChild("RemoteEvents")
    
    if remoteEvents then
        for _, skillName in pairs(DRAGON_SKILLS) do
            local skillEvent = remoteEvents:FindFirstChild(skillName)
            
            if skillEvent then
                -- Bind skill to key presses
                bindSkillToKey(skillName, skillEvent)
            else
                -- Create fake event for testing
                createFakeSkill(skillName)
            end
        end
    end
    
    -- Change player appearance/effects
    applyDragonEffects()
end

-- Bind Skills to Keys
function bindSkillToKey(skillName, skillEvent)
    local keyBindings = {
        ["DragonBreath"] = Enum.KeyCode.Q,
        ["DragonClaw"] = Enum.KeyCode.E,
        ["DragonFlight"] = Enum.KeyCode.R,
        ["DragonTransform"] = Enum.KeyCode.T
    }
    
    local key = keyBindings[skillName]
    
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == key then
            -- Fire skill event
            if skillEvent:IsA("RemoteEvent") then
                skillEvent:FireServer()
            elseif skillEvent:IsA("RemoteFunction") then
                skillEvent:InvokeServer()
            end
            
            -- Visual feedback
            skillFeedback(skillName)
        end
    end)
end

-- Create Fake Skill (if real ones don't exist)
function createFakeSkill(skillName)
    print("Creating fake skill: " .. skillName)
    
    local functionName = skillName .. "Function"
    
    -- Create local effect based on skill
    if skillName == "DragonBreath" then
        spawnFireBreath()
    elseif skillName == "DragonFlight" then
        enableFlight()
    elseif skillName == "DragonTransform" then
        transformToDragon()
    end
end

-- Dragon Breath Effect
function spawnFireBreath()
    local firePart = Instance.new("Part")
    firePart.Size = Vector3.new(5, 1, 10)
    firePart.Position = HumanoidRootPart.Position + Vector3.new(0, 0, 5)
    firePart.Anchored = true
    firePart.BrickColor = BrickColor.new("Bright orange")
    firePart.Material = Enum.Material.Neon
    
    local fire = Instance.new("Fire")
    fire.Parent = firePart
    fire.Color = Color3.fromRGB(255, 100, 0)
    fire.Size = 15
    
    firePart.Parent = Workspace
    game.Debris:AddItem(firePart, 3)
end

-- Flight Ability
function enableFlight()
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Parent = HumanoidRootPart
    bodyVelocity.MaxForce = Vector3.new(0, 10000, 0)
    
    UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Space then
            bodyVelocity.Velocity = Vector3.new(0, 50, 0)
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Space then
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        end
    end)
end

-- Dragon Transformation
function transformToDragon()
    -- Change character appearance temporarily
    for _, part in pairs(Character:GetChildren()) do
        if part:IsA("BasePart") then
            part.BrickColor = BrickColor.new("Bright blue")
            part.Material = Enum.Material.Neon
            
            local glow = Instance.new("PointLight")
            glow.Parent = part
            glow.Color = Color3.fromRGB(0, 200, 255)
            glow.Range = 5
        end
    end
    
    -- Increase size/scale
    Character.Humanoid:WaitForChild("BodyHeightScale").Value = 1.5
    Character.Humanoid:WaitForChild("BodyWidthScale").Value = 1.5
    
    -- Timer for transformation duration
    wait(30)
    
    -- Revert transformation
    revertTransformation()
end

function revertTransformation()
    for _, part in pairs(Character:GetChildren()) do
        if part:IsA("BasePart") then
            part.BrickColor = BrickColor.new("Medium stone grey")
            part.Material = Enum.Material.Plastic
            
            local light = part:FindFirstChild("PointLight")
            if light then
                light:Destroy()
            end
        end
    end
    
    Character.Humanoid:WaitForChild("BodyHeightScale").Value = 1
    Character.Humanoid:WaitForChild("BodyWidthScale").Value = 1
end

-- Apply Dragon Visual Effects
function applyDragonEffects()
    -- Add permanent dragon aura
    local aura = Instance.new("Part")
    aura.Name = "DragonAura"
    aura.Size = Vector3.new(5, 5, 5)
    aura.Position = HumanoidRootPart.Position
    aura.Anchored = false
    aura.CanCollide = false
    aura.Transparency = 0.7
    aura.BrickColor = BrickColor.new("Bright blue")
    
    local weld = Instance.new("Weld")
    weld.Parent = aura
    weld.Part0 = HumanoidRootPart
    weld.Part1 = aura
    weld.C0 = CFrame.new(0, 0, 0)
    
    local particleEmitter = Instance.new("ParticleEmitter")
    particleEmitter.Parent = aura
    particleEmitter.Color = ColorSequence.new(Color3.fromRGB(0,とに、255))
    particleEmitter.Size = NumberSequence.new(1)
    particleEmitter.Lifetime = NumberRange.new(1, 3)
    particleEmitter.Rate = 50
    
    aura.Parent = Character
end

-- Skill Feedback Visualization
function skillFeedback(skillName)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Parent = Player.PlayerGui
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Parent = screenGui
    textLabel.Text = skillName .. " Activated!"
    textLabel.Size = UDim2.new(0, 200, 0, 50)
    textLabel.Position = UDim2.new(0.5, -100, 0.8, 0)
    textLabel.BackgroundColor3 = Color3.fromRGB(0, 100, 255)
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.Font = Enum.Font.GothamBold
    
    game.Debris:AddItem(screenGui, 1)
end

-- Main Execution
spawnWesternDragonFruit()

-- Optional: Auto-spawn every 60 seconds
while true do
    wait(60)
    spawnWesternDragonFruit()
end
